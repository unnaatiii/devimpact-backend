# ── DevImpact API (Express) — copy to `.env` in this folder ─────────────────
# Never commit `.env`.
#
# Use `.env` for real keys (this file is a template; Node does not load `.env.example`).

PORT=8000

# CORS: set to your Next.js origin in production, e.g. https://app.example.com
# Use * for permissive dev (default if unset in code is wide open via cors()).

# ── Supabase (service role — server only) ───────────────────────────────────
# Create a project at https://supabase.com — paste URL and service_role key from Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
USER_ID_PEPPER=

# ── OpenRouter (AI analysis) ──────────────────────────────────────────────
OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://localhost:3000
OPENROUTER_ANALYSIS_MODEL=google/gemini-2.0-flash-001
OPENROUTER_COMMIT_DELAY_MS=200
OPENROUTER_AI_BATCH_SIZE=6
OPENROUTER_AI_BATCH_MAX_TOKENS=8000

# ── GitHub org webhook + batch AI ───────────────────────────────────────────
#GITHUB_WEBHOOK_SECRET=
#GITHUB_ORG_SYNC_TOKEN=
